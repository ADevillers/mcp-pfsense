# pfSense base URL (no trailing slash)
PFSENSE_URL=https://pfsense.example.com

# API key (System > REST API > Keys). Never commit this file.
PFSENSE_API_KEY=

# Verify TLS certificates (set false only for lab self-signed certs)
PFSENSE_VERIFY_TLS=true

# Optional request timeout in seconds
PFSENSE_TIMEOUT=30
